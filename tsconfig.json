{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["electron-vite/node"]
  },

  "include": ["src/**/*.ts", "src/**/*.svelte", "electron.vite.config.ts"]
}
